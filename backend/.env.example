# ============================================================
# GIS Portal — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# MongoDB connection string
# Local:  mongodb://localhost:27017/gis_portal
# Atlas:  mongodb+srv://<user>:<pass>@cluster.xxxxx.mongodb.net/gis_portal
MONGODB_URI=mongodb://localhost:27017/gis_portal

# Secret key for signing JWT tokens (change this in production!)
JWT_SECRET=gis_portal_secret_key_2024

# Server port (optional, defaults to 5000)
PORT=5000
